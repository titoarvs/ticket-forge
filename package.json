{
  "name": "ticketforge",
  "version": "1.0.1",
  "description": "Turn requirement documents into epics, tickets, acceptance criteria and test cases with Claude.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "db:push": "node --env-file-if-exists=.env --import tsx scripts/db-push.ts",
    "db:migrate-host": "node --env-file-if-exists=.env --import tsx scripts/db-migrate-host.ts",
    "db:cutover-load": "node scripts/db-cutover-load.mjs",
    "db:schema": "node scripts/drizzle-schema.mjs",
    "db:check": "node scripts/drizzle-schema.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "docs:overview": "node --import tsx scripts/overview-docx.ts",
    "docs:pain-points": "node --import tsx scripts/pain-points-docx.ts",
    "docs:problem-statement": "node --import tsx scripts/problem-statement-docx.ts",
    "legacy": "node --env-file-if-exists=.env --import tsx legacy/server.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
