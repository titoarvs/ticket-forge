    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@playwright/test": "^1.65.0",
    "@reactour/tour": "3.8.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dayjs": "^1.11.23",
    "docx": "^9.15.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "fflate": "0.8.3",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
