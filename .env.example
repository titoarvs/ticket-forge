# Copy this file to .env and fill in what you need, then run `npm start`.

# ---- Database (Supabase) -------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string → URI.
# Use the "Session pooler" string (port 5432) and put your database password in it.
# Leave empty to use the built-in local database in data/db.
DATABASE_URL=
# SSL to the database: leave empty (encrypted, certificate not verified),
# "verify" to also verify the certificate, or "disable" for local Postgres without SSL.
PGSSL=

# ---- Public address -------------------------------------------------------
# The address people use to open TicketForge. Invite and password-reset links point here.
APP_URL=http://localhost:5173
PORT=5173

# ---- Email (SMTP) for invites and password resets -------------------------
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your normal password).
# SendGrid: smtp.sendgrid.net, port 587, user "apikey", password = your API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TicketForge <you@yourcompany.com>"
# Or, for SendGrid only (leave SMTP_HOST empty):
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM=no-reply@yourcompany.com
# SENDGRID_FROM_NAME="Your Company"

# ---- Claude ---------------------------------------------------------------
# Leave empty to use your Claude account through Claude Code; set to use an API key instead.
ANTHROPIC_API_KEY=

# Set when running behind a reverse proxy (nginx, Render, Fly) so HTTPS and client IPs are detected.
TRUST_PROXY=
