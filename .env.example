# Copy this file to .env and fill in what you need, then run `npm start`.

# ---- Database (Supabase) -------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string → URI.
# Use a pooler string and put your database password in it: "Session pooler" (port 5432) or, when
# several servers share the database, "Transaction pooler" (port 6543), which allows many more connections.
# Connect as the postgres user: TicketForge creates its tables and row-level security on start.
# Leave empty to use the built-in local database in data/db.
DATABASE_URL=
# Connections each TicketForge server keeps open (default 5). Supabase's Session pooler allows 15 in total;
# for a big team use the Transaction pooler (port 6543) and about 20 per server.
PG_POOL_MAX=
# SSL to the database: leave empty (encrypted, certificate not verified),
# "verify" to also verify the certificate, or "disable" for local Postgres without SSL.
PGSSL=
# How long start-up waits for the database before stopping with a connection error (default 10000).
# PG_CONNECT_TIMEOUT_MS=
# Moving to another PostgreSQL host is configuration only: change DATABASE_URL (and PGSSL / PG_POOL_MAX) and redeploy.
# To copy the data with no downtime see docs/postgres-host-migration.md (npm run db:migrate-host).
# Moved host and no TICKETFORGE_SECRET? The saved keys are encrypted with a key derived from the OLD connection string's
# user and password: set it here so they stay readable: TICKETFORGE_KEY_FROM_URL=postgresql://old-user:old-password@old-host/db
# During a cutover, how often servers check for it (ms, default 1000; 0 = off) and how long writes wait (ms, default 30000):
# TICKETFORGE_CUTOVER_POLL_MS=1000
# TICKETFORGE_CUTOVER_HOLD_MS=30000

# ---- Hosted mode (optional) -----------------------------------------------
# TICKETFORGE_MODE=saas turns on workspaces, plans and payments. In that mode this computer's folders, git and Claude
# Code are off, even at localhost. To try hosted mode on your own computer and still use them, set the line below.
# It does the same with TRUST_PROXY. Only requests from this computer to localhost get them. Never set it on a server.
# TICKETFORGE_ALLOW_LOCAL=1

# ---- Public address -------------------------------------------------------
# The address people use to open TicketForge. Invite and password-reset links point here.
APP_URL=http://localhost:5173
PORT=5173

# ---- Email (SMTP) for invites and password resets -------------------------
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your normal password).
# SendGrid: smtp.sendgrid.net, port 587, user "apikey", password = your API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TicketForge <you@yourcompany.com>"
# Or, for SendGrid only (leave SMTP_HOST empty):
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM=no-reply@yourcompany.com
# SENDGRID_FROM_NAME="Your Company"

# ---- AI ---------------------------------------------------------------------
# Opened on your own computer (localhost), TicketForge uses your personal Claude account through
# Claude Code: install it and run `claude` once to sign in. Nothing to set here.
# Opened anywhere else (Vercel, a server, a domain), it uses an AI API. The easiest way: an administrator sets it
# up in Administration → AI (the key is stored encrypted). Or set it here; the panel's settings win:
#   AI_PROVIDER: anthropic, openai, gemini, openrouter, groq, deepseek, mistral, xai, together, ollama or custom
#   AI_API_KEY:  your key (or the provider's own variable, e.g. OPENAI_API_KEY, GEMINI_API_KEY, ANTHROPIC_API_KEY)
#   AI_MODEL:    a model your key can use (Anthropic defaults to claude-opus-5-5). Administration → AI lists them.
#   AI_BASE_URL: only for custom (any OpenAI-compatible endpoint) or to override a provider's address
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Override the automatic choice: "account" (always the Claude account) or "api" (always the API).
AI_MODE=
# Optional: encrypts the API key saved in Administration → AI. Default: derived from the database credentials.
TICKETFORGE_SECRET=

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Render, Fly), or to the number of proxies. The sign-in
# and password-reset limits then count each visitor by the address your proxy adds to X-Forwarded-For (nginx:
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for). Leave it empty without a proxy: the header is ignored,
# because any visitor can send it. Not needed on Vercel. Make sure visitors can't reach the port around the proxy.
# It also turns off this computer's folders, git and Claude Code (see TICKETFORGE_ALLOW_LOCAL).
TRUST_PROXY=

# UI references on tickets: largest file in MB (default 10) and allowed extensions (default: png, jpg, jpeg, gif,
# webp, html, htm, pdf, docx, txt, md, json, csv).
# TICKETFORGE_REF_MAX_MB=10
# TICKETFORGE_REF_TYPES=.png,.jpg,.html,.pdf,.docx

# Release announcement: the robot in the corner announces the latest release (or your own message) when this is 1.
# It is off by default. With prefers-reduced-motion the message is shown without animation.
# RELEASE_ANNOUNCEMENT=1
# RELEASE_ANNOUNCEMENT_MESSAGE=Ticket Forge has a new chatbot: ask it anything.

# Google Drive storage (Administration → Google Drive, once the "Google Drive storage" feature is turned on).
# A Google Cloud OAuth client (type "Web application") with the Drive API enabled; add APP_URL + /api/gdrive/callback as
# its authorised redirect URI. Failed saves are retried this many times (default 5) before a document is marked failed.
# TICKETFORGE_GDRIVE_CLIENT_ID=
# TICKETFORGE_GDRIVE_CLIENT_SECRET=
# TICKETFORGE_GDRIVE_MAX_RETRIES=5

# Log every database statement with its time (for finding slow requests).
# TICKETFORGE_SQL_LOG=1
